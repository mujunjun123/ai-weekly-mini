<view class="page">
<view class="top"><text class="brand">◈ OPEN / WEEKLY</text><text class="edition">开源灵感，每周更新</text></view>
<view class="hero"><view class="eyebrow">GITHUB TRENDING · WEEKLY</view><view class="headline">让好项目<view>被<text class="yellow">看见。</text></view></view><view class="subtitle">每周发现，下一件改变效率的 AI 工具。</view><view class="period" bindtap="period">官方周榜 <text>{{meta.updatedAt}}</text> ⓘ</view><view class="hero-mark">↗</view></view>
<view class="footnote">{{status}} · {{origin}}<text wx:if="{{delayed}}"> · 数据更新延迟</text></view>
<view class="stats"><view><text class="stat">{{total}}</text><text class="muted">精选项目</text></view><view><text class="stat">{{growthTotal}}k<text class="yellow"> ↑</text></text><text class="muted">本周新增 Star · 约</text></view><view><text class="stat">{{categoryTotal}}</text><text class="muted">覆盖领域</text></view></view>
<view class="search"><text>⌕</text><input placeholder="搜索项目、用途或分类" value="{{query}}" bindinput="search" placeholder-class="placeholder"/></view>
<scroll-view scroll-x class="filters"><view class="filter-inner"><view wx:for="{{categories}}" wx:key="*this" class="chip {{category===item?'active':''}}" data-value="{{item}}" bindtap="category">{{item}}</view></view></scroll-view>
<view class="section-head"><view><text class="section-title">{{tab==='收藏'?'我的收藏':'开源周榜'}}</text><text class="count"> / {{projects.length}} 项目</text></view><text class="sort" bindtap="sort">{{sort==='growth'?'按周增星':'按名称'}} ↓</text></view>
<view class="list"><view wx:for="{{projects}}" wx:key="id" class="project" data-id="{{item.id}}" bindtap="detail"><text class="rank {{item.rank<4?'first':''}}">{{item.rank<10?'0':''}}{{item.rank}}</text><view class="project-body"><view class="project-name" catchtap="copy" data-id="{{item.id}}">{{item.name}}</view><view class="desc">{{item.summary || item.desc}}</view><view class="meta"><text class="stars">☆ {{item.stars}}</text></view></view><text class="tag purpose-tag" style="background:{{item.color}}">{{item.category}}</text><view class="growth"><text>+{{item.growthLabel}}</text><text class="growth-caption">本周新增</text></view></view></view>
<view wx:if="{{!projects.length}}" class="empty">{{tab==='收藏'?'还没有收藏，点开喜欢的项目试试。':'没有找到项目，换个关键词试试。'}}</view>
<view class="footnote">GitHub 官方周榜 AI 筛选 · {{origin}} · {{meta.updatedAt}}</view>
<view class="bottom"><view class="nav {{tab==='榜单'?'selected':''}}" data-value="榜单" bindtap="tab"><text>▥</text>发现榜单</view><view class="nav {{tab==='收藏'?'selected':''}}" data-value="收藏" bindtap="tab"><text>☆</text>我的收藏 <text class="badge">{{saved.length}}</text></view></view>
<view wx:if="{{selected}}" class="overlay" bindtap="close"><view class="sheet" catchtap="noop"><view class="sheet-top"><text class="tag purpose-tag" style="background:{{selected.color}}">{{selected.category}}</text><text class="close" bindtap="close">✕</text></view><view class="sheet-title">{{selected.name}}</view><view class="sheet-desc">{{selected.summary || selected.desc}}</view><view class="source-link" bindtap="copy">源码：{{selected.name}} ↗（点击复制链接）</view><view class="detail-stats">+{{selected.growth}} 本周新增 · ☆ {{selected.stars}} 总星标</view><view class="notice">{{meta.scope}} 更新：{{meta.updatedAt}}</view><button class="primary" bindtap="save" data-id="{{selected.id}}">收藏 / 取消收藏</button><button class="secondary" bindtap="copy">复制 GitHub 仓库链接</button></view></view>
</view>