 .page{max-width:1120px;margin:auto;padding:0 32px 110px}.top{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #2b322e}.brand{font-size:16px;font-weight:800;letter-spacing:2px}.edition,.muted{font-size:12px;color:#8c9690}.hero{position:relative;padding:42px 0 30px;overflow:hidden}.eyebrow{font-size:11px;letter-spacing:2.5px;color:#c3caad}.headline{font-size:64px;font-weight:850;line-height:1.13;letter-spacing:-3px;margin-top:20px}.yellow{color:#e6f264}.subtitle{font-size:14px;color:#a2aba3;margin-top:20px}.period{font-size:12px;margin-top:26px;color:#e6f264}.period text{margin:0 14px;color:#a2aba3}.hero-mark{position:absolute;right:16px;top:22px;font-size:230px;color:#e6f264;opacity:.13;line-height:1}.stats{display:flex;border-top:1px solid #333b31;border-bottom:1px solid #333b31;padding:22px 0;margin-bottom:26px}.stats>view{flex:1;display:flex;flex-direction:column;gap:8px;padding-left:22px;border-left:1px solid #333b31}.stats>view:first-child{padding:0;border:0}.stat{font-size:27px;letter-spacing:-1px;font-weight:650}.search{display:flex;gap:13px;align-items:center;background:#1c2320;border:1px solid #303a32;border-radius:10px;padding:13px 17px}.search>text{font-size:24px;color:#c0c7bd}.search input{flex:1;font-size:14px;color:#f4f5ed}.placeholder{color:#778178}.filters{margin:20px 0 30px;white-space:nowrap}.filter-inner{display:flex;gap:9px}.chip{padding:9px 19px;font-size:13px;color:#adb4aa;border:1px solid #353d33;border-radius:6px;cursor:pointer}.chip.active{background:#e6f264;color:#202617;border-color:#e6f264;font-weight:700}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.section-title{font-size:23px;font-weight:750}.count{font-size:12px;color:#788475}.sort{font-size:12px;color:#b2bba9;cursor:pointer}.project{display:flex;align-items:center;gap:18px;padding:23px 0;border-bottom:1px solid #2c342e;cursor:pointer}.rank{font-size:23px;color:#64705f;font-weight:700;width:34px;flex-shrink:0;font-variant-numeric:tabular-nums}.rank.first{color:#e6f264}.project-body{flex:1;min-width:0}.project-name{font-size:19px;font-weight:730;letter-spacing:-.4px;overflow-wrap:anywhere}.desc{font-size:12px;color:#a1aa9e;line-height:1.6;margin-top:7px}.meta{display:flex;align-items:center;gap:14px;margin-top:10px}.tag{font-size:10px;border:1px solid #65735d;padding:3px 7px;border-radius:4px}.stars{font-size:11px;color:#8e9b85}.growth{text-align:right;color:#e6f264;font-size:23px;font-weight:750;display:flex;flex-direction:column;gap:7px;min-width:96px;font-variant-numeric:tabular-nums}.growth-caption{font-size:10px;color:#7f8a78;font-weight:400}.footnote{font-size:10px;letter-spacing:.6px;color:#778170;text-align:center;margin:30px 0}.bottom{position:fixed;bottom:0;left:0;right:0;background:#171e19f5;border-top:1px solid #364030;display:flex;justify-content:center;gap:90px;padding:18px 15px calc(18px + env(safe-area-inset-bottom));z-index:5}.nav{font-size:12px;color:#8b9684;display:flex;align-items:center;gap:9px;cursor:pointer}.nav>text:first-child{font-size:24px}.nav.selected{color:#e6f264}.badge{font-size:11px;padding:2px 6px;border-radius:5px;background:#303a29}.empty{padding:55px 0;color:#a1aa9e;text-align:center;font-size:14px}.overlay{position:fixed;inset:0;background:#000a;z-index:20;display:flex;align-items:flex-end;justify-content:center}.sheet{width:100%;max-width:560px;box-sizing:border-box;padding:30px 25px calc(30px + env(safe-area-inset-bottom));border-radius:22px 22px 0 0;background:#20291f;border:1px solid #45513a}.sheet-top{display:flex;justify-content:space-between;align-items:center}.close{padding:8px;cursor:pointer;color:#b2bba9}.sheet-title{font-size:30px;font-weight:750;margin-top:24px;overflow-wrap:anywhere}.sheet-desc{font-size:15px;line-height:1.8;color:#b4bfad;margin:18px 0}.detail-stats{color:#e6f264;font-size:14px}.notice{font-size:12px;color:#8f9d87;line-height:1.8;margin:22px 0}.primary,.secondary{display:block;width:100%;padding:15px;background:#e6f264;color:#222a18;border:0;border-radius:8px;font-size:14px;font-weight:700;margin-top:12px;cursor:pointer;line-height:1.5}.secondary{background:#303b29;color:#d4dfca}@media(min-width:760px){.page{padding-left:90px;padding-right:90px}.hero{padding-top:55px}.headline{font-size:85px}.hero-mark{font-size:280px;right:10px}.project{padding:25px 8px}.project:hover{background:#1a231b}.desc{font-size:14px}.project-name{font-size:21px}.growth{font-size:28px}.stats{max-width:500px}.sheet{align-self:center;border-radius:20px}.bottom{gap:160px}}@media(max-width:390px){.page{padding-left:20px;padding-right:20px}.headline{font-size:57px}.growth{font-size:19px;min-width:80px}.project{gap:10px}.rank{width:28px}.project-name{font-size:17px}.edition{font-size:10px}}

/* Purpose labels stay in a dedicated right-hand column, as in the reference. */
.purpose-tag{display:inline-block;flex-shrink:0;white-space:nowrap;background:#c3d0d7;color:#18212b;border:0;border-radius:5px;padding:5px 8px;font-size:12px;font-weight:750;line-height:1.3;text-align:center;letter-spacing:0}
.project{display:grid;grid-template-columns:34px minmax(0,1fr) 80px 110px;column-gap:18px}
.project>.purpose-tag{justify-self:start}.desc{display:-webkit-box!important;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.filters{overflow-x:auto}.chip{flex-shrink:0}
@media(max-width:600px){.page{padding-left:16px;padding-right:16px}.project{grid-template-columns:24px minmax(0,1fr) 64px 76px;column-gap:8px;padding:20px 0}.rank{width:24px;font-size:20px}.project-name{font-size:15px;line-height:1.4}.growth{min-width:0;font-size:18px}.purpose-tag{font-size:11px;padding:4px 6px}.desc{font-size:11px}.meta{gap:0}.stars{font-size:10px}}

.sheet{max-height:85vh;overflow-y:auto}.source-link{font-size:13px;color:#a8d8ff;margin:14px 0;overflow-wrap:anywhere}
